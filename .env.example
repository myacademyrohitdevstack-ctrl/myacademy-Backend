PORT=5000
NODE_ENV=development
Frontend_Url=http://localhost:3001

# MongoDB Connection String (Atlas URI or local instance)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/myacademy?retryWrites=true&w=majority
# Or local: mongodb://127.0.0.1:27017/myacademy
Mongoose_uri=

# Authentication Secrets
JWT_SECRET=myacademy_super_secure_jwt_secret_key_2026
ACCESS_SECRET=myacademy_super_secure_access_secret_key_2026
REFRESH_SECRET=myacademy_super_secure_refresh_secret_key_2026

# Email Service (Resend)
RESEND_API_KEY=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Platform (Meta Graph API)
PLATFORM_WHATSAPP_ACCESS_TOKEN=
PLATFORM_WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=myacademy_verify_token
